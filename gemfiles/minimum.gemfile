# frozen_string_literal: true

source 'https://rubygems.org'

gemspec path: '..'

Bundler.load_gemspec(File.expand_path('../activemail.gemspec', __dir__)).runtime_dependencies.each do |dep|
  floor = dep.requirement.requirements.find { |op, _| op == '>=' }
  gem dep.name, "= #{floor.last}" if floor
end

gem 'minitest', '5.20.0'
gem 'minitest-mock', '~> 5.27'
gem 'rails', '~> 7.1.0'
gem 'rake', '~> 13.0'
gem 'rubocop', '~> 1.60', require: false

group :test do
  gem 'roadie', '>= 5.0', require: false
  gem 'sass-embedded', '>= 1.69', require: false
end
